{
	auto_https off
}

:80 {
	handle /.well-known/acme-challenge/* {
		root * /var/lib/travel-scam/acme
		file_server
	}
	respond 503
}

https://{$VPS_IP} {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cache-Control no-store
	}
	request_body {
		max_size 12MB
	}
	# Preview entry points only. REST/admin/docs/media remain private, including
	# while the measured upload/query safeguards await PR 37.
	@health {
		method GET HEAD
		path /health
	}
	handle @health {
		reverse_proxy 127.0.0.1:8000
	}
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		respond 404
	}
}
