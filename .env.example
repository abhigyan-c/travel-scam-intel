APP_NAME=Travel Scam Intelligence
APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO
SERPER_API_KEY=
SARVAM_API_KEY=
ADMIN_API_TOKEN=
APP_EMBEDDING_CACHE_DIR=.tools/embedding-cache
APP_RESEARCH_MAX_SEARCH_QUERIES=3
APP_RESEARCH_MAX_SEARCH_RESULTS=30
APP_RESEARCH_MAX_DOCUMENTS_TO_FETCH=10
APP_RESEARCH_MAX_RELEVANT_DOCUMENTS=6
APP_RESEARCH_MAX_LLM_CALLS=12
APP_RESEARCH_MAX_LLM_CONCURRENCY=2
APP_RESEARCH_MAX_TOTAL_SECONDS=25
APP_RESEARCH_FRESH_SECONDS=86400
APP_RESEARCH_RETRY_SECONDS=300
# Proactive research is opt-in. Tune tiers, weights and cycle/daily budgets via this JSON.
APP_SCHEDULER='{"enabled":false}'

# Local development values only. Keep real credentials in .env.
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel-local
POSTGRES_DB=travel_scam_intel
DATABASE_URL=postgresql+psycopg://travel:travel-local@127.0.0.1:5432/travel_scam_intel
REDIS_URL=redis://127.0.0.1:6379/0
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=raw-documents
S3_ACCESS_KEY=travel-local
S3_SECRET_KEY=travel-local-password

# Deployment credential references (not used by the local MinIO profile).
# Keep real values only in the ignored .env or the secrets manager.
# BITWARDEN_MACHINE_ACCESS_TOKEN=   # verify project scope before host installation
# R2_ACCESS=                       # exporter alias for S3_ACCESS_KEY
# R2_SECRET=                       # exporter alias for S3_SECRET_KEY
# R2_TOKEN=                        # management API only; not an S3 credential
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# PROD_APP_UUID=                   # maps to host BWS_APP_PROJECT_ID
# PROD_BACKUP_UUID=                # maps to host BWS_BACKUP_PROJECT_ID
# Optional public MCP URL; DNS-rebinding protection otherwise permits localhost only.
APP_MCP_PUBLIC_URL=
