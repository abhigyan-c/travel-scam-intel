# Nonsecret host configuration. Copy to /etc/travel-scam/production.env.
APP_IMAGE=travel-scam-intel:REPLACE_WITH_COMMIT_SHA
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=travel-scam-objects-prod
MODEL_CACHE=/opt/travel-scam/models
SECRETS_PATH=/run/travel-scam/RELEASE_ID
BWS_APP_PROJECT_ID=REPLACE_WITH_PROJECT_UUID
# Set only after public TLS is configured, to enable certificate-expiry checks:
# PUBLIC_TLS_CERT=/etc/caddy/certs/fullchain.pem
