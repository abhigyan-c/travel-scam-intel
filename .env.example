APP_NAME=Travel Scam Intelligence
APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO
SERPER_API_KEY=

# Local development values only. Keep real credentials in .env.
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel-local
POSTGRES_DB=travel_scam_intel
DATABASE_URL=postgresql+psycopg://travel:travel-local@127.0.0.1:5432/travel_scam_intel
REDIS_URL=redis://127.0.0.1:6379/0
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=raw-documents
S3_ACCESS_KEY=travel-local
S3_SECRET_KEY=travel-local-password
